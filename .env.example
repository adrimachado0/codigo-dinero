# Copy to .env.local and adjust. Validated with Zod in src/shared/config/env.ts.
# On Vercel none is required: SITE_ENV falls back to VERCEL_ENV and NEXT_PUBLIC_SITE_URL to
# https://<the project's production domain>. Set them only to override.

# Public site URL (metadataBase, canonical, sitemap, JSON-LD, OG image URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | preview | production. Only production is indexable (otherwise noindex).
SITE_ENV=development
