# Copy to .env.local and adjust. Validated with Zod in src/shared/config/env.ts.

# Public site URL (metadataBase, canonical, sitemap). Production domain is pending.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# development | preview | production. Only production is indexable (otherwise noindex).
SITE_ENV=development

# Quotes adapter for the market ticker. Only "simulated" exists for now.
QUOTES_PROVIDER=simulated
